<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SWIGGY GNU::8085 - HOTEL ROYAL MUMBAI</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Courier New',monospace;background:#0f0f0f;color:#e0e0e0}
.header{background:#fc8019;color:#000;padding:14px 20px;font-weight:900;font-size:20px;letter-spacing:1px}
.header span{font-size:12px;font-weight:400;margin-left:15px;background:#000;color:#fc8019;padding:3px 8px;border-radius:4px}
.banner{background:#1a1a1a;color:#00ff41;padding:12px 20px;border-bottom:3px solid #fc8019;font-size:13px;line-height:20px}
.banner b{color:#fc8019;background:#2a1a00;padding:2px 6px;border-radius:3px;margin:0 2px}
.tag{background:#00ff41;color:#000;padding:3px 8px;font-weight:900;border-radius:3px}
.registers{display:flex;gap:15px;padding:12px 20px;background:#151515;border-bottom:1px solid #333;font-size:12px;flex-wrap:wrap}
.registers div{background:#0f0f0f;padding:4px 8px;border-radius:4px;border:1px solid #333}
.registers span{color:#00ff41;font-weight:bold}
.main{display:flex;gap:15px;padding:15px;flex-wrap:wrap}
.left{flex:1.2;min-width:320px}.middle{flex:1;min-width:300px}.right{width:280px;background:#1a1a1a;border:2px solid #fc8019;padding:15px;border-radius:10px;height:fit-content}
h3{color:#fc8019;margin:15px 0 10px 0;font-size:14px;border-left:4px solid #fc8019;padding-left:10px;text-transform:uppercase}
.table-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.table{height:85px;border:2px solid #333;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;font-weight:bold;border-radius:8px;transition:0.2s;font-size:14px}
.table:hover{transform:scale(1.05);box-shadow:0 0 10px #00ff41}
.free{background:#0a2a0a;border-color:#00ff41;color:#00ff41}
.booked{background:#3a0a0a;border-color:#ff3333;color:#ff6666}
.sel{background:#332200!important;border-color:orange!important;color:orange!important;box-shadow:0 0 15px orange!important;transform:scale(1.05)}
#console{background:#000;color:#00ff41;height:170px;overflow:auto;padding:12px;border:1px solid #00ff41;font-size:11px;line-height:18px;border-radius:6px;box-shadow:inset 0 0 10px #003300}
.food-card{background:#1e1e1e;border:1px solid #333;display:flex;gap:12px;padding:12px;margin-bottom:12px;border-radius:8px;align-items:center;transition:0.2s}
.food-card:hover{border-color:#fc8019;transform:translateX(5px)}
.food-card img{width:65px;height:65px;border-radius:8px;object-fit:cover;border:1px solid #333}
.food-card button{background:#fc8019;color:#000;border:none;padding:7px 14px;cursor:pointer;font-weight:900;border-radius:5px;margin-top:6px;font-size:12px}
.food-card button:hover{background:#ff9f43;transform:scale(1.05)}
.total{font-size:20px;font-weight:900;color:#00ff41;margin:12px 0;background:#0a1a0a;padding:8px;border-radius:6px;border:1px solid #00ff41;text-align:center}
.hlt-btn{width:100%;background:linear-gradient(90deg,#00ff41,#00cc33);color:#000;border:none;padding:14px;font-weight:900;cursor:pointer;border-radius:8px;font-size:15px;letter-spacing:1px}
.hlt-btn:hover{background:linear-gradient(90deg,#33ff66,#00ff41);transform:scale(1.02)}
footer{text-align:center;padding:20px;color:#666;font-size:11px;border-top:1px solid #222;margin-top:20px;line-height:18px}
#cart-list{font-size:12px;line-height:22px;margin:10px 0;color:#00ff41;background:#0f0f0f;padding:8px;border-radius:5px;min-height:60px;border:1px dashed #333}
small{color:#888}
</style>
</head>
<body>

<div class="header">
  SWIGGY GNU::8085 <span>HOTEL ROYAL MUMBAI - 18008 - 8085 Processor Project by Riya Chavan</span>
</div>

<div class="banner">
  <span class="tag">[GNU SIM8085 DINER KERNEL v2.0]</span>
  <b>CALL=Book Table (MVI M,01H)</b> | <b>PUSH=Order Food (PUSH B)</b> | <b>SP=Cart Count (2300H)</b> | <b>ADI=Billing (2200H)</b> | <b>HLT=Place Order</b><br>
  Swiggy-inspired Diner Management System Using GNU Sim8085 Concepts | Live: riyachavan935-ai.github.io/Riya-Chavan-31
</div>

<div class="registers">
  <div>ACC: <span id="acc">00H</span></div>
  <div>PC: <span id="pc">2000H</span></div>
  <div>SP: <span id="sp-reg">2110H</span></div>
  <div>HL Reg (2050H): <span id="hl">--</span></div>
  <div>SP Count (2300H): <span id="spc">0</span></div>
  <div>Bill (2200H): Rs <span id="bill">0</span></div>
  <div>Z Flag (2301H): <span id="z">0</span></div>
</div>

<div class="main">
  <div class="left">
    <h3>Table Memory [0x2000H] - 6 Tables - Memory-Mapped I/O</h3>
    <div class="table-grid" id="tables"></div>

    <h3>GNU Console Log [0x0000H] - Live 8085 Logs</h3>
    <div id="console">> SYSTEM BOOT - Hotel Processor<br>> LXI SP,2110H - Food Stack Initialized at 2100H<br>> LXI H,2000H - Table Memory [00 01 00 00 01 00] Loaded<br>> LXI B,0000H - SP Count = 0<br>> READY FOR CALL Operation...<br></div>
  </div>

  <div class="middle">
    <h3>Food Stack - PUSH Operation - Order Stack [2100H]</h3>

    <div class="food-card">
      <img src="https://images.unsplash.com/photo-1568909344668-6f14a07b56a0?w=200" alt="Burger">
      <div>
        <b>Assembly Burger</b> - Classic<br>
        <small>Code: 01H | Price: Rs 150 | GNU: ADI 96H | PUSH B</small><br>
        <button onclick="order(1,'Burger',150)">ADD TO CART - PUSH</button>
      </div>
    </div>

    <div class="food-card">
      <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=200" alt="Pizza">
      <div>
        <b>Byte Code Pizza</b> - Extra Cheese<br>
        <small>Code: 02H | Price: Rs 350 | GNU: ADI 5EH+01H | PUSH B</small><br>
        <button onclick="order(2,'Pizza',350)">ADD TO CART - PUSH</button>
      </div>
    </div>

    <div class="food-card">
      <img src="https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=200" alt="Cola">
      <div>
        <b>Debug Cola</b> - Cold Drink<br>
        <small>Code: 03H | Price: Rs 50 | GNU: ADI 32H | PUSH B</small><br>
        <button onclick="order(3,'Cola',50)">ADD TO CART - PUSH</button>
      </div>
    </div>

    <div class="food-card">
      <img src="https://images.unsplash.com/photo-1589302168068-964664d93dc0?w=200" alt="Biryani">
      <div>
        <b>Kernel Biryani</b> - Hyderabadi<br>
        <small>Code: 04H | Price: Rs 250 | GNU: ADI FAH | PUSH B</small><br>
        <button onclick="order(4,'Biryani',250)">ADD TO CART - PUSH</button>
      </div>
    </div>

  </div>

  <div class="right">
    <h3>Memory Stack [2100H-2110H]</h3>
    <div>SP Count (2300H): <span id="cart-sp" style="color:#00ff41;font-weight:bold">0</span> Items</div>
    <div id="cart-list">Cart Empty<br><small>PUSH Operation se food add karo</small></div>
    <hr style="border-color:#333;margin:10px 0">
    <div class="total">Total Bill [2200H]: Rs <span id="total">0</span></div>
    <button class="hlt-btn" onclick="hlt()">PLACE ORDER - HLT INSTRUCTION</button>
    <br><br>
    <div style="background:#0f0f0f;padding:10px;border-radius:6px;border:1px solid #333">
      <b style="color:#fc8019">Memory Map (GNU Sim):</b><br>
      <small>
      2000H-2005H: Table Status (00H=Free, 01H=Booked)<br>
      2050H: HL Register - Selected Table ID<br>
      2100H-2110H: Food Stack - Order List<br>
      2200H-2201H: Total Bill (16-bit) - ADI<br>
      2300H: SP Count - INR C, STA 2300H<br>
      2301H: Z Flag - Booking Success/Fail<br>
      SP: 2110H Initial, PUSH decrements
      </small>
    </div>
  </div>
</div>

<footer>
  Project: Smart Hotel Table Allocator Processor Using 8085, Verilog HDL & GNU Simulator<br>
  Live: https://riyachavan935-ai.github.io/Riya-Chavan-31/ |
  GitHub: riyachavan935-ai/Riya-Chavan-31 |
  Student: Riya Chavan |
  GNU Mapping: 2000H=Table Memory, 2050H=HL Register, 2200H=Bill (ADI), 2300H=SP Count, 2301H=Z Flag, CALL=Book, PUSH=Order, HLT=Checkout
</footer>

<script>
// SMART HOTEL ALLOCATOR - GNU SIM 8085 LOGIC IN JAVASCRIPT
let tableMemory=[0,1,0,0,1,0]; // 2000H-2005H : 0=Free, 1=Booked
let hlReg=null; // 2050H
let spCount=0; // 2300H
let totalBill=0; // 2200H
let zFlag=0; // 2301H
let foodStack=[]; // 2100H
let spReg=0x2110;

function renderTables(){
 let html='';
 tableMemory.forEach((status,i)=>{
   let cls=status==1?'booked':'free';
   if(hlReg==i) cls+=' sel';
   let txt=status==1?'BOOKED':'FREE';
   html+=`<div class="table ${cls}" onclick="bookTable(${i})">T0${i+1}<br><small>${txt}</small><br><small>200${i}H</small></div>`;
 });
 document.getElementById('tables').innerHTML=html;
 updateRegisters();
}

function updateRegisters(){
 document.getElementById('hl').innerText= hlReg!=null? `T0${hlReg+1} (0x200${hlReg}H)`:'--';
 document.getElementById('spc').innerText=spCount;
 document.getElementById('bill').innerText=totalBill;
 document.getElementById('total').innerText=totalBill;
 document.getElementById('cart-sp').innerText=spCount;
 document.getElementById('z').innerText=zFlag;
 document.getElementById('sp-reg').innerText=spReg.toString(16).toUpperCase()+'H';
 let cartHtml= foodStack.length? foodStack.map(f=>`> PUSH ${f.name} | Code=0${f.code}H | Price=${f.price} | SP=000${spCount}H | ADI ${f.price.toString(16).toUpperCase()}H`).join('<br>') : 'Cart Empty<br><small>PUSH to add food to stack [2100H]</small>';
 document.getElementById('cart-list').innerHTML=cartHtml;
}

function log(msg){
 let con=document.getElementById('console');
 con.innerHTML+=`> ${msg}<br>`;
 con.scrollTop=con.scrollHeight;
}

function bookTable(id){
 if(tableMemory[id]==1){
   log(`CALL T0${id+1} - FAIL | MOV A,M | MVI A,01H | CPI 01H | JZ BOOK_FAIL | Z=0 | ACC=01H Already BOOKED`);
   zFlag=0; renderTables(); return;
 }
 tableMemory[id]=1; hlReg=id; zFlag=1;
 document.getElementById('acc').innerText='01H';
 document.getElementById('pc').innerText=`200${id}H`;
 log(`CALL T0${id+1} - Allocation Success | LXI H,2000H | MVI A,0${id}H | ADD L | MOV L,A | MOV A,M | CPI 00H | MVI M,01H | STA 2050H | HL=T0${id+1} | ACC=RESERVED | Z=1`);
 renderTables();
}

function order(code,name,price){
 if(hlReg==null){ alert('Pehle Table Book Karo! CALL Operation - Table pe click karo'); return; }
 foodStack.push({code,name,price});
 spCount++; totalBill+=price; spReg=0x2110-spCount;
 let adiHex=price.toString(16).toUpperCase()+'H';
 log(`PUSH ${name} | Code=0${code}H | MVI A,0${code}H | PUSH B | INR C | MOV A,C | STA 2300H | LXI H,2200H | MOV A,M | ADI ${adiHex} | STA 2200H | MEM[210${spCount-1}H]=0${code}H | SP=000${spCount}H | Bill=${totalBill}`);
 updateRegisters();
}

function hlt(){
 if(spCount==0){ alert('Cart Khali Hai! PUSH se food add karo'); return; }
 log(`HLT - Order Placed | POP PSW | Total SP=${spCount} | Bill Rs ${totalBill} | STA 2200H | Z=1 | HALT - Order Success - Kitchen Notified`);
 alert(`ORDER PLACED - HLT Executed!\n\nTable: T0${hlReg+1} (HL Reg 2050H = 0${hlReg}H)\nTotal Items SP Count (2300H): ${spCount}\nTotal Bill (2200H): Rs ${totalBill}\nZ Flag (2301H): 1 Success\nSP Register: ${spReg.toString(16).toUpperCase()}H\n\nGNU Memory Dump:\n2000H: ${tableMemory.join(' ')} (Tables)\n2050H: 0${hlReg}H (Selected)\n2300H: 0${spCount}H (SP Count)\n2200H: ${totalBill} Rs (Bill)\n2301H: 01H (Z Flag)`);
}

renderTables();
log('LXI H,2000H - Table Memory Loaded: [00 01 00 00 01 00]');
log('READY - Click on FREE table to CALL (Book)');
</script>
</body>
</html>
